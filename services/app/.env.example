# Конфигурация логирования
LOG_LEVEL=INFO

# Конфигурация базы данных
DB_DRIVER=mysql  # Или postgresql, sqlite и др.
DB_HOST=localhost
DB_PORT=3306  # По умолчанию для MySQL
DB_USERNAME=root
DB_PWD=your_db_password
DB_NAME=call_center

# Секретный ключ для Flask
SECRET_KEY=your_random_secret_key

# Другие настройки, если нужны
DEBUG=False

# Администратор
MANAGER_USER=user_name
MANAGER_PWD=user_password

# Url для загрузки файла
RECORD_URL=http://localhost:8088/static/monitor

MANAGEMENT_CONSOLE_URL=http://localhost:8888

# Подключенные модули
MOD_STATISTIC=False
MOD_TRANSCRIPT=False
MOD_RECORD=False
MOD_NEW_CALL=False